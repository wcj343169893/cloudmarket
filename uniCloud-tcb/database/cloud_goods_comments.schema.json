	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"created": {
			"bsonType": "timestamp",
			"description": "上传时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"modified": {
			"bsonType": "timestamp",
			"description": "修改时间",
			"defaultValue": {
				"$env": "now"
			}
		},
		"operater": {
			"bsonType": "string",
			"title": "操作员",
			"description": "操作员",
			"foreignKey": "uni-id-users._id"
		},
		"content": {
			"bsonType": "string",
			"title": "内容"
		},
		"reply": {
			"bsonType": "string",
			"title": "回复",
			"componentForEdit": {
				"name": "uni-easyinput",
				"props": {
					"type": "textarea"
				}
			}
		},
		"goods_id": {
			"bsonType": "string",
			"title": "商品",
