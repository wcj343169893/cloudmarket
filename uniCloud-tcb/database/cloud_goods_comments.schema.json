				"collection": "cloud_shops",
				"field": "name as text, id as value"
			}
		},
		"state": {
			"bsonType": "int",
			"title": "是否显示"
		},
		"star": {
			"bsonType": "int",
			"title": "评分"
		},
		"starResult": {
			"bsonType": "string",
			"title": "评分内容"
		},
		"tags": {
			"bsonType": "array",
