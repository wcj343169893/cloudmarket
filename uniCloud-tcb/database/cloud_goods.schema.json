{
	"bsonType": "object",
	"required": ["title", "price", "shopid", "stock"],
	"permission": {
		"read": true,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"created": {
			"bsonType": "timestamp",
			"description": "上传时间",
			"defaultValue": {
				"$env": "now"
			}
		},
		"modified": {
			"bsonType": "timestamp",
			"description": "修改时间",
			"defaultValue": {
				"$env": "now"
			}
		},
		"operater": {
			"bsonType": "string",
			"title": "操作员",
			"description": "操作员",
			"foreignKey": "uni-id-users._id",
			"defaultValue": {
				"$env": "uid"
			}
		},
		"id": {
			"bsonType": "int",
			"title": "编号"
		},
		"src": {
			"bsonType": "string",
			"title": "封面图",
			"component": {
				"name": "cloud-image",
				"props": {
					"name": "src",
					"v-model": "formData.src"
				}
			}
		},
		"banner": {
			"bsonType": "string",
			"title": "横图",
			"component": {
				"name": "cloud-image",
				"props": {
					"name": "banner",
					"v-model": "formData.banner"
				}
			}
		},
		"title": {
			"bsonType": "string",
			"title": "商品名称",
			"defaultValue": ""
		},
		"subTitle": {
			"bsonType": "string",
			"title": "子标题",
			"defaultValue": ""
		},
		"price": {
			"bsonType": "double",
			"title": "销售价格",
			"defaultValue": 0
		},
		"originPrice": {
			"bsonType": "double",
			"title": "原价",
			"defaultValue": 0
		},
		"monthlySale": {
			"bsonType": "int",
			"title": "月售量",
			"defaultValue": 0
		},
		"categories": {
			"bsonType": "array",
			"title": "分类"
		},
		"shopid": {
			"bsonType": "int",
			"title": "店铺",
			"description": "商品店铺",
			"foreignKey": "cloud_shops.id",
			"enum": {
				"collection": "cloud_shops",
				"field": "name as text, id as value"
			}
		},
		"stock": {
			"bsonType": "int",
			"title": "剩余库存",
			"defaultValue": 100
		},
		"visite": {
			"bsonType": "int",
			"title": "浏览量",
			"defaultValue": 0
		},
		"limit": {
			"bsonType": "int",
			"title": "限购数量",
			"description": "0不限制",
			"defaultValue": 0
		},
		"isCategoryShow": {
			"bsonType": "int",
			"title": "分类是否显示",
			"description": "0 下架 1 在售",
			"defaultValue": 0,
			"enum": [{
				"text": "下架",
				"value": 0
			}, {
				"text": "在售",
				"value": 1
			}]
		},
		"isSold": {
			"bsonType": "int",
			"title": "是否销售",
			"description": "销售类型：0 下架 1 在售",
			"defaultValue": 0,
			"enum": [{
				"text": "下架",
				"value": 0
			}, {
				"text": "在售",
				"value": 1
			}]
		},
		"isLimit": {
			"bsonType": "bool",
			"title": "是否限购",
			"description": "",
			"defaultValue": false
		},
		"isNewUser": {
			"bsonType": "bool",
			"title": "是否新用户",
			"description": "",
			"defaultValue": false
		},
		"isRecommend": {
			"bsonType": "bool",
			"title": "是否推荐",
			"description": "",
			"defaultValue": false
		},
		"posid": {
			"bsonType": "int",
			"title": "排序",
			"defaultValue": 0
		},
		"onlySelfTake": {
			"bsonType": "int",
			"defaultValue": 0,
			"title": "仅自提",
			"enum": [{
				"text": "否",
				"value": 0
			}, {
				"text": "是",
				"value": 1
			}]
		},
		"saleType": {
			"bsonType": "string",
			"title": "销售类型",
			"enum": [{
				"text": "正常销售",
				"value": "normal"
			}, {
				"text": "提前预定",
				"value": "yuding"
			}, {
				"text": "社区团购",
				"value": "tuangou"
			}]
		},
		"score": {
			"bsonType": "int",
			"title": "评分",
			"description": "商品评分，1-100",
			"defaultValue": 100
		},
		"share": {
			"bsonType": "string",
			"title": "分享词"
		},
		"skus": {
			"bsonType": "array",
			"title": "多规格"
		},
		"skuname": {
			"bsonType": "array",
			"title": "规格名称"
		},
		"specsType": {
			"bsonType": "string",
			"title": "规格类型",
			"enum": [{
				"text": "单规格",
				"value": "single"
			}, {
				"text": "多规格",
				"value": "multiple"
			}]
		},
		"storage_condition": {
			"bsonType": "string",
			"title": "储存条件"
		},
		"net_weight": {
			"bsonType": "string",
			"title": "净重"
		},
		"manufacture": {
			"bsonType": "string",
			"title": "生成日期"
		},
		"guarantee_period": {
			"bsonType": "string",
			"title": "保质期"
		},
		"tuangou": {
			"bsonType": "object",
			"title": "团购信息"
		},
		"upc": {
			"bsonType": "string",
			"title": "条码"
		},
		"offlineTime": {
			"bsonType": "timestamp",
			"title": "下线时间"
		},
		"imgs": {
			"bsonType": "array",
			"title": "轮播图",
			"component": {
				"name": "cloud-image",
				"props": {
					"name": "imgs",
					"v-model": "formData.imgs",
					":imageNumber": 8
				}
			}
		},
		"description": {
			"bsonType": "array",
			"title": "详情图",
			"component": {
				"name": "cloud-image",
				"props": {
					"name": "description",
					"v-model": "formData.description",
					":imageNumber": 10
				}
			}
		},
		"onlineTime": {
			"bsonType": "timestamp",
			"description": "上架时间",
			"defaultValue": {
				"$env": "now"
			}
		}
	}
}
